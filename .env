ERP_API_DEBUG_SHARED_SECRET=petra-erp
DEBUG_CENTER_DASHBOARD_USER=neuralSoft
DEBUG_CENTER_DASHBOARD_PASSWORD=neuralSoft
DEBUG_CENTER_MAX_LOGS=300
DEBUG_CENTER_REDIS_KEY=erp-api-debug-center:logs

# Self-hosted Redis on the app server. REDIS_URL wins when both forms are set;
# a blank REDIS_PASSWORD means the server has no auth.
REDIS_URL=redis://10.10.33.248:6379
REDIS_HOST=10.10.33.248
REDIS_PORT=6379
REDIS_PASSWORD=

# Managed fallback (Vercel KV / Upstash). Ignored while REDIS_URL or REDIS_HOST is set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
